<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Chat.Desktop.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Chat.Desktop.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             Width="400"
             Height="400">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="Bold" Text="用户注册" Margin="0,0,0,20"/>
        <TextBox PlaceholderText="请输入用户名" Width="300" Height="40" Margin="0,0,0,10"/>
        <TextBox PasswordChar="*" PlaceholderText="请输入密码" Width="300" Height="40" Margin="0,0,0,10"/>
        <TextBox PasswordChar="*" PlaceholderText="请确认密码" Width="300" Height="40" Margin="0,0,0,20"/>
        <Button Content="注册" Width="300" Height="40" Background="#8B5CF6" Foreground="White" CornerRadius="20"/>
    </StackPanel>

</UserControl>