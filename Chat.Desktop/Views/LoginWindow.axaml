<u:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Chat.Desktop.ViewModels"
        xmlns:u="https://irihi.tech/ursa"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Chat.Desktop.LoginWindow"
        x:DataType="vm:LoginWindowViewModel"
        Width="420"
        Height="540"
        Title="用户登录 - Chat_v"
        CanResize="False">

    <Design.DataContext>
        <vm:LoginWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部标题栏 -->
        <Panel Grid.Row="0"
               Height="90"
               Background="{DynamicResource SemiPurple2Color}">
            <TextBlock Theme="{StaticResource TitleTextBlock}"
                       Classes="H2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Text="通启天涯系统登录" />
            <TextBlock VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       FontSize="12"
                       Opacity="0.7"
                       Text="" />
        </Panel>

        <!-- 中间表单区域 -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">

            <!-- 用户名 -->
            <TextBox PlaceholderText="请输入用户名"
                     MaxLength="30"
                     Text="{Binding UserName}"
                     IsEnabled="{Binding !IsLoading}">
                <TextBox.InnerLeftContent>
                    <PathIcon Width="14" Data="{DynamicResource SemiIconUser}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- 密码 -->
            <TextBox Classes="RevealPasswordButton"
                     PlaceholderText="请输入密码"
                     Text="{Binding Password}"
                     IsEnabled="{Binding !IsLoading}">
                <TextBox.InnerLeftContent>
                    <PathIcon Width="14" Data="{DynamicResource SemiIconLock}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- 状态消息 -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SemiDangerColor}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Height="36"
                       IsVisible="{Binding StatusMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- 登录按钮 -->
            <u:IconButton Classes="Primary"
                          Icon="{StaticResource SemiIconTick}"
                          Theme="{DynamicResource SolidIconButton}"
                          CornerRadius="22"
                          Content="登 录"
                          Command="{Binding OkClickCommand}"
                          IsEnabled="{Binding !IsLoading}" />

            <!-- 取消按钮 -->
            <u:IconButton Classes="Tertiary"
                          Icon="{StaticResource SemiIconClose}"
                          CornerRadius="22"
                          Content="取 消"
                          Command="{Binding CancelClickCommand}"
                          IsEnabled="{Binding !IsLoading}" />

            <!-- 注册链接 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="还没有账号？" FontSize="12" Opacity="0.6" />
                <HyperlinkButton Content="立即注册"
                                 FontSize="12"
                                 Command="{Binding RegisterClickCommand}"
                                 IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
        </StackPanel>

        <!-- 底部信息 -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Spacing="4">
            <!-- 加载指示器 -->
            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Width="200"
                         Height="3" />
            <TextBlock Text=".NET 9.0 + Avalonia + TouchSocket WebSocket"
                       FontSize="11"
                       Opacity="0.4"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</u:UrsaWindow>
