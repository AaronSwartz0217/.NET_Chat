<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Chat.Desktop"
             xmlns:vm="using:Chat.Desktop.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Chat.Desktop.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部导航栏 - 天蓝色风格 -->
        <Border Grid.Row="0" Height="48" Background="#00A6FF" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <!-- 标题 -->
                <TextBlock Grid.Column="0" Text="天涯世界" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,8,0" Foreground="White"/>

                <!-- 三个导航按钮（水平排列） -->
                <Button Grid.Column="1" Content="我的" Command="{Binding SwitchToProfileCommand}"
                        VerticalAlignment="Center" Margin="4,0"
                        Background="{Binding SelectedTabIndex, Converter={x:Static local:TabBgConverter.Instance}, ConverterParameter=0}"
                        Padding="12,6" FontSize="14" Foreground="White"
                        BorderThickness="0"/>

                <Button Grid.Column="2" Content="聊天室" Command="{Binding SwitchToChatCommand}"
                        VerticalAlignment="Center" Margin="4,0"
                        Background="{Binding SelectedTabIndex, Converter={x:Static local:TabBgConverter.Instance}, ConverterParameter=1}"
                        Padding="12,6" FontSize="14" Foreground="White"
                        BorderThickness="0"/>

                <Button Grid.Column="3" Content="论坛" Command="{Binding SwitchToForumCommand}"
                        VerticalAlignment="Center" Margin="4,0"
                        Background="{Binding SelectedTabIndex, Converter={x:Static local:TabBgConverter.Instance}, ConverterParameter=2}"
                        Padding="12,6" FontSize="14" Foreground="White"
                        BorderThickness="0"/>

                <!-- 弹性空白 -->
                <Rectangle Grid.Column="4" />

                <!-- 退出登录 -->
                <Button Grid.Column="5" Content="退出登录" Command="{Binding DoLogoutCommand}"
                        Classes="Hyperlink" FontSize="12" Margin="0,0,16,0"
                        VerticalAlignment="Center" Foreground="White" Background="Transparent"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- 主体内容区 -->
        <ContentControl Grid.Row="1">
            <ContentControl.Content>
                <MultiBinding Converter="{x:Static local:TabContentConverter.Instance}">
                    <Binding Path="SelectedTabIndex"/>
                    <Binding Path="ProfileVM"/>
                    <Binding Path="ChatVM"/>
                    <Binding Path="ForumVM"/>
                </MultiBinding>
            </ContentControl.Content>
        </ContentControl>
    </Grid>
</UserControl>