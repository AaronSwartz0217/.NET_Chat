<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Chat.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Chat.Desktop.Views.DataEditView"
             x:DataType="vm:DataEditViewModel">

    <Grid RowDefinitions="*,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="10" Padding="10">
            <TextBlock Text="编辑数据" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="ID: " />
            <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel>
        
        <DockPanel Grid.Row="1" HorizontalAlignment="Right" Spacing="10" Margin="10">
            <Button Content="确定" Command="{Binding OkClickCommand}"/>
            <Button Content="取消" Command="{Binding CancelClickCommand}"/>
        </DockPanel>
    </Grid>

</UserControl>
