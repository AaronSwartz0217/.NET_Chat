<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chat.Desktop.App"
             xmlns:local="using:Chat.Desktop"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <semi:UrsaSemiTheme Locale="zh-CN"/>

        <!-- 导航菜单按钮样式 -->
        <Style Selector="Button.NavMenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.NavMenuButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
        </Style>
        <Style Selector="Button.NavMenuButton:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedColor}"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 浅色模式 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextColor" Color="#1f2937"/>
                    <SolidColorBrush x:Key="BackgroundColor" Color="#ffffff"/>
                    <SolidColorBrush x:Key="HoverColor" Color="#f3f4f6"/>
                    <SolidColorBrush x:Key="PressedColor" Color="#e5e7eb"/>
                    <SolidColorBrush x:Key="CardColor" Color="#ffffff"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#e5e7eb"/>
                </ResourceDictionary>
                <!-- 深色模式 -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextColor" Color="#f9fafb"/>
                    <SolidColorBrush x:Key="BackgroundColor" Color="#111827"/>
                    <SolidColorBrush x:Key="HoverColor" Color="#374151"/>
                    <SolidColorBrush x:Key="PressedColor" Color="#4b5563"/>
                    <SolidColorBrush x:Key="CardColor" Color="#1f2937"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#374151"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
